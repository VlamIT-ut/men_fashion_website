{
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "frontend/**/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/admin/(.*)", "dest": "/frontend/admin/$1" },
    { "src": "/payment/(.*)", "dest": "/frontend/payment/$1" },
    { "src": "/css/(.*)", "dest": "/frontend/css/$1" },
    { "src": "/js/(.*)", "dest": "/frontend/js/$1" },
    { "src": "/images/(.*)", "dest": "/frontend/images/$1" },
    { "src": "/fonts/(.*)", "dest": "/frontend/fonts/$1" },
    { "src": "/vendor/(.*)", "dest": "/frontend/vendor/$1" },
    { "src": "/(.*\\.php)", "dest": "/frontend/$1" },
    { "src": "/", "dest": "/frontend/index.php" },
    { "src": "/(.*)", "dest": "/frontend/$1" }
  ]
}
